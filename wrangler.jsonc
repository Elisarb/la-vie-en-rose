{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "la-vie-en-rose",
  "main": "./_worker.js",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "la-vie-en-rose-catalog",
      "database_id": "b7d57bf2-7016-4640-9f73-6c8713344731",
      "migrations_dir": "migrations"
    }
  ]
}
